# All text files stored as LF — overrides core.autocrlf on all platforms
* text=auto eol=lf

*.sh         text eol=lf
*.bash       text eol=lf
*.py         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.toml       text eol=lf
*.txt        text eol=lf
*.cfg        text eol=lf
*.ini        text eol=lf
*.env        text eol=lf
*.js         text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.mmd        text eol=lf
Dockerfile   text eol=lf
Makefile     text eol=lf

# Binary — no conversion
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.gz         binary
*.zip        binary
*.tar        binary
